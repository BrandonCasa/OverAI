{
  "window": {
    "process_name": "game.exe",
    "title_regex": "^Game Title(?:$| - )"
  },
  "movement": {
    "left": "A",
    "right": "D",
    "forward": "W",
    "reverse": "S"
  },
  "buttons": [
    "MOUSE1",
    "MOUSE2",
    "SPACE",
    "E",
    "Q",
    "SHIFT"
  ],
  "pause_key": "F8",
  "emergency_stop_key": "F9",
  "invert_axes": [
    false,
    false
  ],
  "telemetry_provider": "hud_telemetry",
  "hud_telemetry": {
    "example_coordinates_only": true,
    "reference_resolution": [
      1920,
      1080
    ],
    "ocr": {
      "threshold": 160,
      "scale": 4.0,
      "allowed_glyphs": "0123456789.%/",
      "polarity": "light_on_dark",
      "minimum_confidence": 0.72
    },
    "health": {
      "bbox": [100, 950, 180, 48],
      "maximum": 100,
      "max_stale_seconds": 0.5
    },
    "charge": {
      "bbox": [1640, 950, 180, 48],
      "max_stale_seconds": 0.5
    },
    "hitmarker": {
      "points": [[950, 530], [970, 530], [950, 550], [970, 550]],
      "colors": [[255, 255, 255], [255, 64, 64]],
      "debounce_seconds": 0.0,
      "rearm_seconds": 0.1
    },
    "kill": {
      "points": [
        [820, 120],
        [860, 120],
        [900, 120],
        [940, 120],
        [980, 120],
        [1020, 120],
        [1060, 120]
      ],
      "colors": [[255, 255, 255]],
      "debounce_seconds": 0.0,
      "rearm_seconds": 0.2
    },
    "similarity_threshold": 0.9,
    "similarity_metric": "normalized_rgb_euclidean_v1",
    "failure_termination_seconds": null
  }
}
